# Стартовый пример. Задача 2 из docs/spec/tasks.md приводит файл в соответствие со схемой в packages/config/src/env.ts.
# Реальные значения не коммитить. Секреты генерируются при установке (infra/scripts/install.sh).

NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://crm:crm@localhost:5432/crm

AUTH_SECRET=
ENCRYPTION_KEY=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm
S3_ACCESS_KEY=
S3_SECRET_KEY=

EMAIL_FROM=crm@example.test
SMTP_URL=smtp://localhost:1025

# ИИ выключен по умолчанию. Ключ принадлежит заказчику.
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_MONTHLY_REQUEST_BUDGET=300

LOG_LEVEL=info
